  for (int row = 0; row < height; row++)
    for (int column = 0; column < width; column++) {
      uint16_t pixelColor = pgm_read_word(&spriteImage[(height - 1 - row) * width + column]);
      if (pixelColor != 0xFFFF) display.writePixel(x + column, y + row, pixelColor);
    }
  display.endWrite();
}

void drawSpriteNoFlip(int x, int y, const uint16_t* spriteImage, int width, int height) {
  display.startWrite();
  for (int row = 0; row < height; row++)
    for (int column = 0; column < width; column++) {
      uint16_t pixelColor = pgm_read_word(&spriteImage[row * width + column]);
      if (pixelColor != 0xFFFF) display.writePixel(x + column, y + row, pixelColor);
    }
  display.endWrite();
}

void drawPet(int x, int y) { drawSpriteTransparent(x, y, epd_bitmap_pet, PET_WIDTH, PET_HEIGHT); }

void enterPetScreen() {
  display.fillScreen(PET_SCREEN_COLOR);
  petPositionY = display.height() / 2 - PET_HEIGHT / 2;
  petPositionX = display.width() / 2 - PET_WIDTH / 2;
  drawPet(petPositionX, petPositionY);
}

void updatePetMovement() {
  if (millis() - lastPetStepTime < PET_STEP_INTERVAL) return;
  lastPetStepTime = millis();
  int previousX = petPositionX;
  petPositionX += petDirection * PET_STEP_SIZE;
  if (petPositionX < 2) { petPositionX = 2; petDirection = 1; }
  int maxRightPosition = display.width() - PET_WIDTH - 2;
  if (petPositionX > maxRightPosition) { petPositionX = maxRightPosition; petDirection = -1; }
  display.fillRect(previousX, petPositionY, PET_WIDTH, PET_HEIGHT, PET_SCREEN_COLOR);
  drawPet(petPositionX, petPositionY);
}

const char* menuItems[3] = { "Status", "Food", "Play" };
int selectedMenuItem = 0;
#define MENU_SCREEN_COLOR  0xD65D

void drawMenuItem(int itemIndex) {
  int rowTop = 52 + itemIndex * 32;
  bool isSelected = (itemIndex == selectedMenuItem);
  display.fillRect(6, rowTop - 3, display.width() - 12, 28, MENU_SCREEN_COLOR);
  if (isSelected) display.fillRoundRect(10, rowTop, display.width() - 20, 22, 10, ST77XX_WHITE);
  const char* label = menuItems[itemIndex];
  display.setTextSize(1);
  display.setTextColor(TEXT_COLOR);
  display.setCursor((display.width() - (int)strlen(label) * 6) / 2, rowTop + 7);
  display.print(label);
}

void drawMenuScreen() {
  display.fillScreen(MENU_SCREEN_COLOR);
  printCentered("MENU", 28, 2, HEADER_COLOR);
  for (int i = 0; i < 3; i++) drawMenuItem(i);   // FIXED: was drawMwnuItem
}

int hungerLevel = 70, funLevel = 70, happinessLevel = 70;
unsigned long lastStatDecreaseTime = 0;
const unsigned long STAT_DECREASE_INTERVAL = 15000;

int keepBetween0And100(int value) {
  if (value < 0) return 0;
  if (value > 100) return 100;
  return value;
}



void drawStatBar(int y, const char* label, int value, uint16_t barColor) {
  display.setTextSize(1);
  display.setTextColor(TEXT_COLOR);
  display.setCursor(12, y);
  display.print(label);
  int barX = 12, barY = y + 12, barWidth = display.width() - 24, barHeight = 14, cornerRadius = 7;
  display.fillRoundRect(barX, barY, barWidth, barHeight, cornerRadius, BAR_EMPTY_COLOR);
  int filledWidth = (value * barWidth) / 100;
  if (value > 0 && filledWidth < 2 * cornerRadius) filledWidth = 2 * cornerRadius;
  if (filledWidth > barWidth) filledWidth = barWidth;
  if (value > 0) display.fillRoundRect(barX, barY, filledWidth, barHeight, cornerRadius, barColor);
  display.drawRoundRect(barX, barY, barWidth, barHeight, cornerRadius, BAR_OUTLINE_COLOR);
}


void drawStatusScreen() {
  display.fillScreen(BACKGROUND_COLOR);
  printCentered("STATUS", 26, 2, HEADER_COLOR);
  drawStatBar(54,  "HUNGER", hungerLevel,    HUNGER_BAR_COLOR);
  drawStatBar(90,  "FUN",    funLevel,       FUN_BAR_COLOR);
  drawStatBar(126, "HAPPY",  happinessLevel, HAPPY_BAR_COLOR);
}




const int FOOD_COUNT = 2;
const uint16_t* foodImages[FOOD_COUNT] = { epd_bitmap_Sushi, epd_bitmap_chocolate };
const char*     foodNames[FOOD_COUNT]  = { "Sushi", "Chocolate" };
int selectedFood = 0;


void drawFoodItem() {
  display.fillRect(0, 48, display.width(), 72, BACKGROUND_COLOR);
  int imageX = (display.width() - 40) / 2;
  display.drawRGBBitmap(imageX, 54, foodImages[selectedFood], 40, 40);
  printCentered(foodNames[selectedFood], 100, 2, TEXT_COLOR);
}


void drawFoodScreen() {
  display.fillScreen(BACKGROUND_COLOR);
  printCentered("FOOD", 26, 2, HEADER_COLOR);
  drawFoodItem();
}



const int foodHungerGain[FOOD_COUNT]    = {  8, 25 };
const int foodHappinessGain[FOOD_COUNT] = { 20,  5 };


void playSelectSound() {
  tone(BUZZER_PIN, 988, 70);   delay(80);
  tone(BUZZER_PIN, 1319, 110); delay(120);
  noTone(BUZZER_PIN);
}

void playHappySound() {
  int noteFrequencies[] = { 784, 988, 1319 };
  for (int i = 0; i < 3; i++) { tone(BUZZER_PIN, noteFrequencies[i], 130); delay(150); }
  noTone(BUZZER_PIN);
}



void playEatingAnimation(const uint16_t* foodImage) {
  display.fillScreen(PET_SCREEN_COLOR);
  const int petX = 8, petY = 60, foodX = 80, foodY = 60;
  drawPet(petX, petY);
  drawSpriteTransparent(foodX, foodY, foodImage, 40, 40);
  delay(350);
  for (int i = 1; i <= 3; i++) {
    tone(BUZZER_PIN, 250 + i * 80, 90);
    int eatenWidth = (40 * i) / 3;
    display.fillRect(foodX, foodY, eatenWidth, 40, PET_SCREEN_COLOR);
    delay(300);
  }
  playHappySound();
}

void drawPlayScreen() {
  display.fillScreen(BACKGROUND_COLOR);
  printCentered("PLAY", 26, 2, HEADER_COLOR);
  int imageX = (display.width() - 40) / 2;
  drawSpriteTransparent(imageX, 54, epd_bitmap_game, 40, 40);
  printCentered("Game", 100, 2, TEXT_COLOR);
}

void playBallAnimation() {
  display.fillScreen(PET_SCREEN_COLOR);
  const int petX = 8, petY = 60, ballX = 80, ballDownY = 60, ballUpY = 30;
  drawPet(petX, petY);
  drawSpriteTransparent(ballX, ballDownY, epd_bitmap_game, 40, 40);
  delay(250);
  const int ballHeights[4] = { ballUpY, ballDownY, ballUpY, ballDownY };
  for (int i = 0; i < 4; i++) {
    display.fillRect(ballX, 30, 40, 70, PET_SCREEN_COLOR);
    drawSpriteTransparent(ballX, ballHeights[i], epd_bitmap_game, 40, 40);
    int beepPitch;
    if (ballHeights[i] == ballUpY) beepPitch = 880;
    else beepPitch = 440;
    tone(BUZZER_PIN, beepPitch, 90);
    delay(180);
  }
  playHappySound();
}









void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(SCREEN_BACKLIGHT_PIN, OUTPUT);
  pinMode(SCROLL_BUTTON_PIN, INPUT_PULLUP);
  pinMode(SELECT_BUTTON_PIN, INPUT_PULLUP);
  pinMode(BACK_BUTTON_PIN,   INPUT_PULLUP);

  digitalWrite(SCREEN_BACKLIGHT_PIN, HIGH);

  display.initR(INITR_GREENTAB);
  display.setRotation(0);

  uint8_t colorOrderCommand = ST77XX_MADCTL_MX | ST77XX_MADCTL_MY;
  display.sendCommand(ST77XX_MADCTL, &colorOrderCommand, 1);

  drawTitleScreen();
  playStartupJingle();
}

void loop() {
  ButtonPress pressedButton = getPressedButton();

  if (currentScreen == PET && millis() - lastStatDecreaseTime > STAT_DECREASE_INTERVAL) {
    lastStatDecreaseTime = millis();
    hungerLevel    = keepBetween0And100(hungerLevel - 1);
    funLevel       = keepBetween0And100(funLevel - 1);
    happinessLevel = keepBetween0And100(happinessLevel - 1);
  }






  switch (currentScreen) {
    case TITLE:
      if (pressedButton != NO_BUTTON) {
        playBeep();
        enterPetScreen();
        currentScreen = PET;
      }
      break;

    case PET:
      updatePetMovement();
      if (pressedButton == SCROLL_BUTTON) {
        playBeep();
        drawMenuScreen();
        currentScreen = MENU;
      }
      break;

    case MENU:
      if (pressedButton == SCROLL_BUTTON) {
        playBeep();
        int previousMenuItem = selectedMenuItem;
        if (selectedMenuItem == 2) selectedMenuItem = 0;
        else selectedMenuItem = selectedMenuItem + 1;
        drawMenuItem(previousMenuItem);
        drawMenuItem(selectedMenuItem);
      } else if (pressedButton == SELECT_BUTTON) {
        if (selectedMenuItem == 0) {
          playBeep();
          drawStatusScreen();
          currentScreen = STATUS_SCREEN;
        } else if (selectedMenuItem == 1) {
          playBeep();
          currentScreen = FOOD;
          selectedFood = 0;
          drawFoodScreen();
        } else {
          playBeep();
          currentScreen = PLAY;
          drawPlayScreen();
        }
      } else if (pressedButton == BACK_BUTTON) {
        playBeep();
        enterPetScreen();
        currentScreen = PET;
      }
      break;


      case STATUS_SCREEN:
      if (pressedButton == BACK_BUTTON) {
        playBeep();
        drawMenuScreen();
        currentScreen = MENU;
      }
      break;


    case FOOD:
      if (pressedButton == SCROLL_BUTTON) {
        playBeep();
        if (selectedFood == FOOD_COUNT - 1) selectedFood = 0;
        else selectedFood = selectedFood + 1;
        drawFoodItem();
      } else if (pressedButton == SELECT_BUTTON) {
        playSelectSound();
        hungerLevel    = keepBetween0And100(hungerLevel + foodHungerGain[selectedFood]);
        happinessLevel = keepBetween0And100(happinessLevel + foodHappinessGain[selectedFood]);
        playEatingAnimation(foodImages[selectedFood]);
        enterPetScreen();
        currentScreen = PET;
      } else if (pressedButton == BACK_BUTTON) {
        playBeep();
        currentScreen = MENU;
        drawMenuScreen();
      }
      break;

    case PLAY:
      if (pressedButton == SELECT_BUTTON) {
        playSelectSound();
        funLevel       = keepBetween0And100(funLevel + 15);
        happinessLevel = keepBetween0And100(happinessLevel + 15);
        playBallAnimation();
        enterPetScreen();
        currentScreen = PET;
      } else if (pressedButton == BACK_BUTTON) {
        playBeep();
        currentScreen = MENU;
        drawMenuScreen();
      }
      break;





  }
}

